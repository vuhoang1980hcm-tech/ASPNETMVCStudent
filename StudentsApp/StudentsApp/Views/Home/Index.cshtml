@{
    ViewBag.Title = "Home Page";
}

<div class="py-5 text-center">
    <h1>School Management</h1>
    <p class="lead">Manage students, courses, instructors, departments and enrollments.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Students</h5>
                <p class="card-text">Add, edit, delete and view student records.</p>
                @Html.ActionLink("Manage Students", "Index", "Students", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Courses</h5>
                <p class="card-text">Manage courses, credits and their departments.</p>
                @Html.ActionLink("Manage Courses", "Index", "Courses", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Instructors</h5>
                <p class="card-text">Manage instructors and their hire dates.</p>
                @Html.ActionLink("Manage Instructors", "Index", "Instructors", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Departments</h5>
                <p class="card-text">Manage departments, budgets and start dates.</p>
                @Html.ActionLink("Manage Departments", "Index", "Departments", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Enrollments</h5>
                <p class="card-text">Track which students are enrolled in which courses, with grades.</p>
                @Html.ActionLink("Manage Enrollments", "Index", "Enrollments", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>